#!/bin/bash
# ===================================================================================
#  CamFlow for Omarchy & Hyprland
#  Description: Professional Universal Bridge for Phones and Capture Cards
#  Author: Daury DiCaprio | #VERyGoodforlife
# ===================================================================================

# --- ANSI Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

VIRTUAL_DEVICE="/dev/video0"
DEFAULT_RES="1280x720"
DEFAULT_FPS="60"

send_notification() {
    notify-send -i camera-web "CamFlow" "$1"
}

cleanup() {
    echo -e "\n${YELLOW}[!] Terminating stream and releasing resources...${NC}"
    sudo fuser -k $VIRTUAL_DEVICE &>/dev/null
    pkill -f "ffmpeg.*$VIRTUAL_DEVICE" &>/dev/null
    sudo modprobe -r v4l2loopback uvcvideo &>/dev/null
    sudo modprobe uvcvideo &>/dev/null
    send_notification "CamFlow stopped. Hardware released."
    echo -e "${GREEN}[✓] Cleanup complete. System restored.${NC}"
    exit 0
}

trap cleanup SIGINT SIGTERM

show_banner() {
    clear
    echo -e "${CYAN}=======================================${NC}"
    echo -e "${CYAN}      CamFlow for Omarchy Linux        ${NC}"
    echo -e "${BLUE}    Universal Phone & HDMI Bridge      ${NC}"
    echo -e "${CYAN}=======================================${NC}"
}

show_usage() {
    show_banner
    echo -e "${BOLD}Usage:${NC} camflow [OPTION]"
    echo -e "\n${BOLD}Available Options:${NC}"
    echo -e "  ${CYAN}--on${NC}      : Start Default Bridge (720p @ 60fps) ${GREEN}[Recommended]${NC}"
    echo -e "  ${CYAN}--30${NC}      : Start Battery Saver Mode (720p @ 30fps)"
    echo -e "  ${CYAN}--hd${NC}      : Start High Definition (1080p @ 30fps)"
    echo -e "  ${CYAN}--full${NC}    : Start Pro Ultra Mode (1080p @ 60fps)"
    echo -e "  ${CYAN}--status${NC}  : Show current streaming status"
    echo -e "  ${CYAN}--off${NC}     : Disconnect and restore system drivers"
    echo -e "\n${YELLOW}Example:${NC} camflow --on"
    echo -e "${CYAN}---------------------------------------${NC}"
}

detect_source() {
    mapfile -t devices < <(v4l2-ctl --list-devices | grep -A 1 -E "Pixel|Android|Capture|Video Capture|Webcam" | grep "/dev/video" | awk '{print $1}')
    
    if [ ${#devices[@]} -eq 0 ]; then
        SRC_PATH=""
    elif [ ${#devices[@]} -eq 1 ]; then
        SRC_PATH="${devices[0]}"
    else
        echo -e "${MAGENTA}${BOLD}[?] Multiple hardware sources found:${NC}"
        for i in "${!devices[@]}"; do
            dev_info=$(v4l2-ctl --device="${devices[$i]}" -D | grep "Card type" | cut -d ":" -f 2 | xargs)
            [[ "$dev_info" == *"Pixel"* || "$dev_info" == *"Android"* ]] && icon="📱" || icon="📸"
            echo -e "  ${CYAN}[$i]${NC} $icon ${BOLD}$dev_info${NC} (${YELLOW}${devices[$i]}${NC})"
        done
        echo -e "${CYAN}---------------------------------------${NC}"
        stty sane
        echo -ne "${MAGENTA}${BOLD}Select device number [0-$((${#devices[@]}-1))]: ${NC}"
        read -r idx
        idx=$(echo "$idx" | tr -d -c '0-9')
        SRC_PATH="${devices[$idx]}"
    fi
}

start_bridge() {
    local res=$1
    local fps=$2
    local mode_name=$3

    if ! sudo -v; then
        echo -e "${RED}[!] Authentication required to manage video drivers.${NC}"
        exit 1
    fi

    echo -e "${BLUE}[*] Preparing kernel modules...${NC}"
    sudo fuser -k $VIRTUAL_DEVICE &>/dev/null
    sudo modprobe -r uvcvideo v4l2loopback &>/dev/null
    sudo modprobe v4l2loopback exclusive_caps=1 card_label="CamFlow_Virtual" video_nr=0
    sudo modprobe uvcvideo &>/dev/null
    
    sleep 1.5
    detect_source
    
    if [ -z "$SRC_PATH" ]; then
        echo -e "${RED}[!] Error: No compatible device detected.${NC}"
        send_notification "Connection failed: No device found."
        exit 1
    fi

    DEVICE_NAME=$(v4l2-ctl --device="$SRC_PATH" -D | grep "Card type" | cut -d ":" -f 2 | xargs)
    
    show_banner
    echo -e "${GREEN}[✓] BRIDGE ACTIVE!${NC}"
    echo -e "${BOLD}Source Device:${NC} ${MAGENTA}$DEVICE_NAME${NC}"
    echo -e "${BOLD}Virtual Slot :${NC} ${YELLOW}$VIRTUAL_DEVICE${NC}"
    echo -e "${BOLD}Video Quality:${NC} ${GREEN}$mode_name ($res @ $fps FPS)${NC}"
    echo -e "${CYAN}---------------------------------------${NC}"
    echo -e "${YELLOW}${BOLD}ℹ️  STREAMING IN PROGRESS...${NC}"
    echo -e "${YELLOW}Keep this window open. Press [CTRL+C] to stop.${NC}"
    echo -e "${CYAN}---------------------------------------${NC}"

    send_notification "Active: $DEVICE_NAME ($res @ $fps)"

    ffmpeg -hide_banner -loglevel info -stats \
    -f v4l2 -input_format mjpeg -video_size "$res" -framerate "$fps" -i "$SRC_PATH" \
    -vcodec copy -f v4l2 -preset ultrafast -tune zerolatency "$VIRTUAL_DEVICE"
}

case "$1" in
    --on)     start_bridge "$DEFAULT_RES" "$DEFAULT_FPS" "Standard Smooth" ;;
    --30)     start_bridge "1280x720" "30" "Battery Saver" ;;
    --hd)     start_bridge "1920x1080" "30" "High Definition" ;;
    --full)   start_bridge "1920x1080" "60" "Pro Ultra" ;;
    --status)
        show_banner
        # FIX: Look for the specific virtual device path in the process list
        FF_PID=$(pgrep -f "ffmpeg.*$VIRTUAL_DEVICE")
        if [ -z "$FF_PID" ]; then
            echo -e "${RED}[○] STATUS: INACTIVE${NC}"
        else
            echo -e "${GREEN}[●] STATUS: ACTIVE${NC}"
            echo -e "${CYAN}Streaming to:${NC} $VIRTUAL_DEVICE"
            # Get actual parameters from the running process
            ps -fp "$FF_PID" | grep -oE "video_size [0-9x]+|framerate [0-9]+"
            echo -e "${YELLOW}(Signal is currently being broadcasted)${NC}"
        fi
        ;;
    --off)    cleanup ;;
    *)        show_usage ;;
esac
